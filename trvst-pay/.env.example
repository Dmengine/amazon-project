# TRVST PAY configuration. Copy to .env and fill in; never commit real values.
# Load it with:  node --env-file=.env src/server.js

PORT=4242
# Public base URL of this service, used to build paylink URLs and provider callbacks.
TRVST_PAY_PUBLIC_URL=http://localhost:4242
# Comma-separated origins allowed to call the API from a browser (the storefront).
TRVST_PAY_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# "live" calls the real provider APIs; "mock" (default) fakes them so you can develop offline.
TRVST_PAY_MODE=mock
# Where paylink records are kept.
TRVST_PAY_STORE_FILE=./data/paylinks.json
# Bearer key the merchant backend/storefront must send to create paylinks. Leave empty to disable (dev only).
TRVST_PAY_API_KEY=

# --- OpenPayd (bank / open-banking pay-ins) ---
OPENPAYD_BASE_URL=https://sandbox.openpayd.com
OPENPAYD_USERNAME=
OPENPAYD_PASSWORD=
# Account holder the pay-ins are booked to (returned by the token call if left empty).
OPENPAYD_ACCOUNT_HOLDER_ID=
# The OpenPayd account that receives the funds.
OPENPAYD_ACCOUNT_ID=
OPENPAYD_TOKEN_PATH=/api/oauth/token
OPENPAYD_PAYIN_PATH=/api/transactions/open-banking/payins
# Shared secret for verifying OpenPayd webhooks (HMAC-SHA256 of the raw body, hex).
OPENPAYD_WEBHOOK_SECRET=

# --- Global Payments GP API (card, Pay by Link) ---
GP_BASE_URL=https://apis.sandbox.globalpay.com/ucp
GP_APP_ID=
GP_APP_KEY=
GP_API_VERSION=2021-03-22
GP_ACCOUNT_NAME=transaction_processing
GP_CHANNEL=CNP
GP_COUNTRY=GB
